{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness Constraints */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Path Aliases (Modern TS without deprecated baseUrl) */
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@terrain/*": ["./src/terrain/*"],
      "@geo/*": ["./src/geo/*"],
      "@ui/*": ["./src/ui/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@map-bridge/*": ["./src/map-bridge/*"],
      "@features/*": ["./src/features/*"]
    }
  },
  "include": ["src", "tools"]
}
